{
  "name": "specmesh",
  "displayName": "specmesh",
  "description": "Cross-repo documentation graph for the agentic spec-driven development lifecycle: indexes charter/epic/FR/ADR/reference/instructions/skill docs across every open workspace folder (charter/epic opt-in per repo), flags broken cross-repo links, orphaned docs, and missing tracked files.",
  "version": "0.14.0",
  "publisher": "specmesh",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "specmesh",
          "title": "specmesh",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "specmesh": [
        {
          "id": "specmesh.docsExplorer",
          "name": "Docs",
          "icon": "media/icon.svg",
          "when": "specmesh.viewMode != 'graph'"
        },
        {
          "id": "specmesh.docsGraph",
          "name": "Docs",
          "type": "webview",
          "icon": "media/icon.svg",
          "when": "specmesh.viewMode == 'graph'"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "specmesh.docsExplorer",
        "contents": "No tracked docs found in this workspace yet.\n[Scaffold Spec-Driven Development Structure](command:specmesh.scaffoldSdlc)\n\nAlready have docs that aren't showing up? Add a `.specmesh.yml` to that repo to tell specmesh what to track."
      }
    ],
    "languageModelTools": [
      {
        "name": "specmesh_list_docs",
        "displayName": "List specmesh Docs",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshDocs",
        "modelDescription": "Lists docs tracked by specmesh across open workspace folders (charter/epic/ADR/reference/FR spec-plan-tasks-walkthrough/instructions/skill, plus any repo-specific types from .specmesh.yml). Use to find a doc by title, type, or repo before reading or editing it. Supports optional folder/type/query filters; query matches title or file path substrings.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "description": "Restrict to this workspace folder name."
            },
            "type": {
              "type": "string",
              "description": "Restrict to this doc type, e.g. 'adr', 'reference', 'fr-spec', 'instructions', 'skill'."
            },
            "query": {
              "type": "string",
              "description": "Case-insensitive substring to match against the doc's title or file path."
            }
          }
        }
      },
      {
        "name": "specmesh_find_broken_links",
        "displayName": "Find Broken specmesh Links",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshBrokenLinks",
        "modelDescription": "Finds relative markdown links in specmesh-tracked docs (including cross-repo links between open workspace folders) that don't resolve to an existing file. Use to answer 'are there broken links' or before trusting a doc's links.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "description": "Restrict to this workspace folder name."
            }
          }
        }
      },
      {
        "name": "specmesh_find_orphans",
        "displayName": "Find Orphaned specmesh Docs",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshOrphans",
        "modelDescription": "Finds ADRs/reference docs/FR specs that no other tracked doc links to (charter/epic docs are legitimate roots and excluded). Use to answer 'which docs are unreferenced/orphaned'.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "description": "Restrict to this workspace folder name."
            }
          }
        }
      },
      {
        "name": "specmesh_find_missing_docs",
        "displayName": "Find Missing Tracked Files",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshMissing",
        "modelDescription": "Finds literal (wildcard-free) .specmesh.yml/specmesh.docTypes track entries (e.g. a specific docs/charter.md) whose file no longer exists. Use to answer 'is anything specmesh expects missing'.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "description": "Restrict to this workspace folder name."
            }
          }
        }
      },
      {
        "name": "specmesh_get_doc_links",
        "displayName": "Get specmesh Doc Links",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshDocLinks",
        "modelDescription": "Returns the outgoing markdown links (text, target, whether it resolves) for one specmesh-tracked doc, identified by a relative or absolute file path. Use after specmesh_list_docs to inspect what a specific doc links to.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative (e.g. 'docs/adr/ADR-004-....md') or absolute path of the tracked doc."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "specmesh_list_repos",
        "displayName": "List specmesh Declared Repos",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshRepos",
        "modelDescription": "Lists child repos declared via a .specmesh.yml 'repos' list (name, remote, relative path, and whether the path currently exists on disk). Use to answer 'which repos make up this workspace' or 'is a declared repo missing/not cloned yet'.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "description": "Restrict to this workspace folder name."
            }
          }
        }
      },
      {
        "name": "specmesh_update_track_entry",
        "displayName": "Update specmesh Track Entry",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshUpdateConfig",
        "modelDescription": "Adds or replaces one doc-type entry in a workspace folder's .specmesh.yml 'track' list (creating the file, seeded from specmesh's built-in defaults, if it doesn't exist yet). Use when a repo needs a new/changed tracked doc type or glob, or an 'exclude' pattern. Rewrites the whole file from parsed entries, so pre-existing comments in that file are not preserved. Requires user confirmation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "description": "The workspace folder name whose .specmesh.yml to update."
            },
            "type": {
              "type": "string",
              "description": "Doc type id, e.g. 'adr', 'charter', or a custom type name."
            },
            "label": {
              "type": "string",
              "description": "Human-readable category label shown in the Docs tree, e.g. 'ADRs'."
            },
            "glob": {
              "type": "string",
              "description": "Glob relative to the folder root, e.g. 'docs/adr/ADR-*.md'. Wildcard-free globs are treated as one expected file and flagged 'missing' if absent."
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional glob(s) relative to the folder root to exclude from this entry's matches."
            }
          },
          "required": [
            "folder",
            "type",
            "label",
            "glob"
          ]
        }
      },
      {
        "name": "specmesh_get_help",
        "displayName": "specmesh Help",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "specmeshHelp",
        "modelDescription": "Returns specmesh's own README (what it is, doc types/defaults, .specmesh.yml schema and examples, scaffold command, tree icon legend, settings, commands). Use whenever a question is about how specmesh itself works, its conventions, or its configuration, before guessing.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "commands": [
      {
        "command": "specmesh.refresh",
        "title": "specmesh: Refresh Docs Index"
      },
      {
        "command": "specmesh.showOrphans",
        "title": "specmesh: Show Orphaned Docs"
      },
      {
        "command": "specmesh.showMissing",
        "title": "specmesh: Show Missing Tracked Files"
      },
      {
        "command": "specmesh.scaffoldSdlc",
        "title": "specmesh: Scaffold Spec-Driven Development Structure"
      },
      {
        "command": "specmesh.openOrCreateConfig",
        "title": "specmesh: Open or Create .specmesh.yml"
      },
      {
        "command": "specmesh.expandCategory",
        "title": "specmesh: Show More Docs"
      },
      {
        "command": "specmesh.addNewDoc",
        "title": "specmesh: Add New Doc…",
        "icon": "$(add)"
      },
      {
        "command": "specmesh.deleteDoc",
        "title": "specmesh: Delete Doc",
        "icon": "$(trash)"
      },
      {
        "command": "specmesh.enableCentralTracking",
        "title": "specmesh: Enable Cross-Repo Doc Tracking"
      },
      {
        "command": "specmesh.migrateRepoDocs",
        "title": "specmesh: Migrate Repo Docs to Central Tracking"
      },
      {
        "command": "specmesh.untrackRepoDocs",
        "title": "specmesh: Untrack Repo from Central Tracking"
      },
      {
        "command": "specmesh.showCentralHistory",
        "title": "Show Central Doc History"
      },
      {
        "command": "specmesh.refreshCentralScm",
        "title": "Refresh Central Doc Status",
        "icon": "$(refresh)"
      },
      {
        "command": "specmesh.stageCentralChange",
        "title": "specmesh: Stage Change",
        "icon": "$(add)"
      },
      {
        "command": "specmesh.unstageCentralChange",
        "title": "specmesh: Unstage Change",
        "icon": "$(remove)"
      },
      {
        "command": "specmesh.stageAllCentralChanges",
        "title": "specmesh: Stage All Changes",
        "icon": "$(add)"
      },
      {
        "command": "specmesh.unstageAllCentralChanges",
        "title": "specmesh: Unstage All Changes",
        "icon": "$(remove)"
      },
      {
        "command": "specmesh.commitCentral",
        "title": "specmesh: Commit",
        "icon": "$(check)"
      },
      {
        "command": "specmesh.uncommitCentral",
        "title": "Undo Last Commit"
      },
      {
        "command": "specmesh.switchCentralBranch",
        "title": "Switch Central Branch…",
        "icon": "$(git-branch)"
      },
      {
        "command": "specmesh.manageCentralRemotes",
        "title": "Manage Remotes…"
      },
      {
        "command": "specmesh.pushCentral",
        "title": "Push"
      },
      {
        "command": "specmesh.pullCentral",
        "title": "Pull"
      },
      {
        "command": "specmesh.fetchCentral",
        "title": "Fetch"
      },
      {
        "command": "specmesh.syncCloneRepos",
        "title": "specmesh: Sync/Clone Repos"
      },
      {
        "command": "specmesh.toggleGraphView",
        "title": "specmesh: Toggle Graph View",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "specmesh.filterDocs",
        "title": "specmesh: Filter Docs…",
        "icon": "$(search)"
      },
      {
        "command": "specmesh.clearDocsFilter",
        "title": "specmesh: Clear Docs Filter",
        "icon": "$(clear-all)"
      }
    ],
    "submenus": [
      {
        "id": "specmesh.docsExplorerActions",
        "label": "More Actions",
        "icon": "$(ellipsis)"
      },
      {
        "id": "specmesh.centralScmActions",
        "label": "More Actions",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "specmesh.toggleGraphView",
          "when": "view == specmesh.docsExplorer || view == specmesh.docsGraph",
          "group": "navigation@1"
        },
        {
          "command": "specmesh.filterDocs",
          "when": "view == specmesh.docsExplorer",
          "group": "navigation@2"
        },
        {
          "command": "specmesh.clearDocsFilter",
          "when": "view == specmesh.docsExplorer && specmesh.docsFilterActive",
          "group": "navigation@3"
        },
        {
          "submenu": "specmesh.docsExplorerActions",
          "when": "view == specmesh.docsExplorer",
          "group": "navigation@4"
        }
      ],
      "specmesh.docsExplorerActions": [
        {
          "command": "specmesh.showOrphans",
          "group": "1_specmesh"
        },
        {
          "command": "specmesh.showMissing",
          "group": "1_specmesh"
        },
        {
          "command": "specmesh.refresh",
          "group": "1_specmesh"
        },
        {
          "command": "specmesh.scaffoldSdlc",
          "group": "2_specmesh"
        },
        {
          "command": "specmesh.enableCentralTracking",
          "group": "3_specmesh"
        },
        {
          "command": "specmesh.migrateRepoDocs",
          "group": "3_specmesh"
        },
        {
          "command": "specmesh.untrackRepoDocs",
          "group": "3_specmesh"
        },
        {
          "command": "specmesh.showCentralHistory",
          "group": "3_specmesh"
        },
        {
          "command": "specmesh.syncCloneRepos",
          "group": "3_specmesh"
        }
      ],
      "view/item/context": [
        {
          "command": "specmesh.addNewDoc",
          "when": "view == specmesh.docsExplorer && viewItem == folder",
          "group": "inline"
        },
        {
          "command": "specmesh.deleteDoc",
          "when": "view == specmesh.docsExplorer && viewItem == doc",
          "group": "7_modification"
        }
      ],
      "scm/title": [
        {
          "command": "specmesh.commitCentral",
          "when": "scmProvider == specmeshCentral",
          "group": "navigation@1"
        },
        {
          "submenu": "specmesh.centralScmActions",
          "when": "scmProvider == specmeshCentral",
          "group": "navigation@2"
        }
      ],
      "specmesh.centralScmActions": [
        {
          "command": "specmesh.switchCentralBranch",
          "group": "1_specmesh"
        },
        {
          "command": "specmesh.refreshCentralScm",
          "group": "1_specmesh"
        },
        {
          "command": "specmesh.showCentralHistory",
          "group": "1_specmesh"
        },
        {
          "command": "specmesh.uncommitCentral",
          "group": "2_specmesh"
        },
        {
          "command": "specmesh.manageCentralRemotes",
          "group": "3_specmesh"
        },
        {
          "command": "specmesh.pushCentral",
          "group": "3_specmesh"
        },
        {
          "command": "specmesh.pullCentral",
          "group": "3_specmesh"
        },
        {
          "command": "specmesh.fetchCentral",
          "group": "3_specmesh"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "specmesh.stageAllCentralChanges",
          "when": "scmProvider == specmeshCentral && scmResourceGroup == changes",
          "group": "inline"
        },
        {
          "command": "specmesh.unstageAllCentralChanges",
          "when": "scmProvider == specmeshCentral && scmResourceGroup == staged",
          "group": "inline"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "specmesh.stageCentralChange",
          "when": "scmProvider == specmeshCentral && scmResourceGroup == changes",
          "group": "inline"
        },
        {
          "command": "specmesh.unstageCentralChange",
          "when": "scmProvider == specmeshCentral && scmResourceGroup == staged",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "specmesh",
      "properties": {
        "specmesh.docTypes": {
          "type": "array",
          "description": "Fallback doc types/globs used for any repo that doesn't have its own .specmesh.yml. Each entry: { type, label, glob, exclude? }. Empty array (default) uses specmesh's built-in defaults (ADR/FR/reference/instructions/skill) -- charter/epic are deliberately excluded from the fallback since they're a root-only, opt-in-per-repo concept.",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "glob": {
                "type": "string"
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "label",
              "glob"
            ]
          },
          "default": []
        },
        "specmesh.docLabelFormat": {
          "type": "string",
          "enum": [
            "title",
            "filename",
            "both"
          ],
          "enumDescriptions": [
            "Show only the doc's parsed # title",
            "Show only the file name",
            "Show the title as the label, file name as secondary text (default)"
          ],
          "default": "both",
          "description": "How doc entries are labeled in the specmesh: Docs tree."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "tsc -p ./",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.1"
  }
}
